# Leap Energy — Global Connect Incentives API
# Copy to .env.local and fill in values from your Leap staging credentials.

# Base URL for the incentives API (staging or production)
LEAP_API_URL=https://api.staging.leap.energy

# API key for the incentives API — format: "publicId:secret" (alphanumeric only, no dashes/underscores)
# OR a Clerk JWT starting with "ey". Both are sent as "Authorization: Bearer <value>".
# Get this from whoever manages the Leap partner account for Comet in the identity-service.
LEAP_API_KEY=

# Leap partner UUID for Comet
LEAP_PARTNER_ID=62631455-9dfd-433b-9482-fd043f2336d4

# UUID of any EV charger device in the Leap incentives.device table.
# All Comet products use the same UUID since they're all in the EV_CHARGER category.
# Get it by running: POST /v1.1/global-connect/incentives/devices (internal Leap API, requires MANAGE_INCENTIVE_DATA)
#   with body: {"manufacturer":"Acura","model_number":"Home Charging Station","device_category":"ev_charger"}
# Leave blank to fall back to hardcoded incentive estimates.
LEAP_DEVICE_ID=
