# Comet — Leap Energy Global Connect Incentives API
# Copy to .env.local and fill in values from your Leap partner credentials.

# Base URL for the incentives API (staging or production)
LEAP_API_URL=https://api.staging.leap.energy

# API key — format: "publicId:secret" (alphanumeric only, no dashes/underscores)
# OR a Clerk JWT starting with "ey". Both are sent as "Authorization: Bearer <value>".
LEAP_API_KEY=

# Leap partner UUID for Comet
LEAP_PARTNER_ID=d250d286-774f-4277-8d44-7d03c5ee57c6

# Device UUIDs are now sourced from lib/products.ts (one per product, from the Leap
# incentives.device catalog). No LEAP_DEVICE_ID env var is needed — the API route
# looks up the device UUID from the product's deviceUuid field at request time.

# Google Places API — kept server-side (never exposed to the browser).
# Used to proxy address autocomplete suggestions and to geocode ZIP codes
# as a fallback when the user enters a bare ZIP instead of a full address.
# Add to Vercel as a sensitive environment variable.
GOOGLE_ADDRESS_API_KEY=
